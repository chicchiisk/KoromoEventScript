<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' and '$(Platform)' == 'AnyCPU'">win-x64</RuntimeIdentifier>
    <PlatformTarget Condition="'$(Platform)' == 'AnyCPU'">x64</PlatformTarget>
    <PlatformTarget Condition="'$(Platform)' == 'x64'">x64</PlatformTarget>
    <PlatformTarget Condition="'$(Platform)' == 'ARM64'">ARM64</PlatformTarget>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.0" />
    <PackageReference Include="NUnit" Version="4.3.2" />
    <PackageReference Include="NUnit.Analyzers" Version="4.7.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="5.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="NUnit.Framework" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\source\runtime\KoromoEventScript.Runtime.Core\KoromoEventScript.Runtime.Core.csproj" />
    <Compile Include="..\..\source\runtime\KoromoEventScript.Runtime.Windows\Audio\*.cs" Link="Audio\%(Filename)%(Extension)" />
    <Compile Include="..\..\source\runtime\KoromoEventScript.Runtime.Windows\Bootstrap\*.cs" Link="Bootstrap\%(Filename)%(Extension)" />
    <Compile Include="..\..\source\runtime\KoromoEventScript.Runtime.Windows\Diagnostics\*.cs" Link="Diagnostics\%(Filename)%(Extension)" />
    <Compile Include="..\..\source\runtime\KoromoEventScript.Runtime.Windows\ErrorHandling\*.cs" Link="ErrorHandling\%(Filename)%(Extension)" />
    <Compile Include="..\..\source\runtime\KoromoEventScript.Runtime.Windows\Input\*.cs" Link="Input\%(Filename)%(Extension)" />
    <Compile Include="..\..\source\runtime\KoromoEventScript.Runtime.Windows\Persistence\*.cs" Link="Persistence\%(Filename)%(Extension)" />
    <Compile Include="..\..\source\runtime\KoromoEventScript.Runtime.Windows\Rendering\*.cs" Link="Rendering\%(Filename)%(Extension)" />
    <Compile Include="..\..\source\runtime\KoromoEventScript.Runtime.Windows\Ui\*.cs" Link="Ui\%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
