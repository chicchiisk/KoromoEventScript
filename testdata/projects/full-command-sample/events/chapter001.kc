import Common

standby:
    riku : Riku
    amane : Amane
    noa : Noa

var score: number = 0
var isMorning: bool = true
var selectedIndex: number = 0
var localCast: Actor[] = [riku, amane, noa]
var bonusValues: number[] = [1, 2, 3]

score = score + sharedStep

bg "bg_morning"
show riku 0 "normal"
trans "crossfade"

say riku #sy_chapter001_0001:
    {sharedTitle}の一章目を始めよう

nar #na_chapter001_0002:
    章立てサンプルの朝パート。

if isMorning && score < 3:
    face riku "smile"
    action_jump riku
else if score == 3:
    face amane "think"
else:
    face noa "normal"

while score < 3:
    score = score + 1

for actor in localCast:
    show actor 0

select #se_chapter001_0003:
    case "中庭へ向かう" #courtyard
    case "教室へ戻る" #classroom

label #courtyard
say amane #sy_chapter001_0004:
    中庭から二章へ進もう
jump #end

label #classroom
nar #na_chapter001_0005:
    教室で少しだけ時間をつぶした。

label #end
