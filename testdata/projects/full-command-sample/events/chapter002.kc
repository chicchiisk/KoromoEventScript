import Common

standby:
    riku : Riku
    amane : Amane
    noa : Noa

var retries: number = 0
var ready: bool = false
var threshold: number = 5
var stageActors: Actor[] = [riku, noa, amane]

threshold = threshold - 2

label #chapter2_start

say noa #sy_chapter002_0001:
    二章目では分岐と反復をまとめて確認する

nar #na_chapter002_0002:
    共有配列をもとに表示位置を組み立てる。

bg "bg_evening"
show:
    riku -1 "normal"
    noa 0 "smile"
    amane 1 "normal"

if !ready || retries == 0:
    face noa "smile"
else:
    show noa 0

while retries < 2:
    retries = retries + 1

for actor in stageActors:
    show actor 0

select #se_chapter002_0003:
    case "締めに入る" #finish
    case "もう一度説明する" #repeat

label #repeat
say riku #sy_chapter002_0004:
    補足は以上だ
jump #finish

label #finish
face:
    riku "eye_open"
    amane "eye_open"
    noa "eye_open"

say amane #sy_chapter002_0005:
    これで全体の流れは確認できたね
