import Common

standby:
    riku : Riku
    amane : Amane
    noa : Noa

bg "bg_evening"
show:
    riku -1 "normal"
    amane 0 "smile"
    noa 1 "normal"

say amane #sy_chapter002_0001:
    二章目の中庭ルート。ここから結末候補を選ぶ。

select #se_chapter002_0002:
    case "夕焼けの四章へ進む" #route_chapter004
    case "星空の五章へ進む" #route_chapter005

label #route_chapter004
set_param_string "route_2" "chapter004_intro"
say riku #sy_chapter002_0003:
    夕焼けのほうへ向かおう。
jump #end

label #route_chapter005
set_param_string "route_2" "chapter005_intro"
say noa #sy_chapter002_0004:
    星空を見に行こう。

label #end
