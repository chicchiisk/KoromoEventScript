fn check_prime(candidate: number): bool:
    if candidate < 2:
        return false

    var sieve: bool[] = new bool[candidate + 1](true)
    sieve[0] = false
    sieve[1] = false
    var factor: number = 2
    while factor * factor <= candidate:
        if sieve[factor]:
            var multiple: number = factor * factor
            while multiple <= candidate:
                sieve[multiple] = false
                multiple = multiple + factor
        factor = factor + 1

    return sieve[candidate]

var candidate: number = 104707
var is_prime: bool = check_prime(candidate)
