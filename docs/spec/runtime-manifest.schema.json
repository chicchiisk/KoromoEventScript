{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/chicchiisk/KoromoEventScript/blob/main/docs/spec/runtime-manifest.schema.json",
  "title": "KoromoEventScript Runtime Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "gameId", "title", "defaultLocale", "cliVersion", "target",
    "entryEventListPath", "inputs", "scripts", "events", "assets", "defaults", "build", "localizations"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "gameId": { "$ref": "#/$defs/nonEmptyString" },
    "title": { "$ref": "#/$defs/nonEmptyString" },
    "defaultLocale": { "$ref": "#/$defs/nonEmptyString" },
    "cliVersion": { "$ref": "#/$defs/nonEmptyString" },
    "target": { "enum": ["windows", "unity", "unreal"] },
    "entryEventListPath": { "$ref": "#/$defs/relativePath" },
    "inputs": { "type": "array", "items": { "$ref": "#/$defs/input" } },
    "scripts": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/script" } },
    "events": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/event" } },
    "assets": { "type": "array", "items": { "$ref": "#/$defs/asset" } },
    "defaults": { "$ref": "#/$defs/defaults" },
    "build": { "$ref": "#/$defs/build" },
    "localizations": { "type": "array", "items": { "$ref": "#/$defs/localization" } }
  },
  "allOf": [
    {
      "if": { "properties": { "target": { "enum": ["windows", "unreal"] } }, "required": ["target"] },
      "then": {
        "properties": {
          "assets": { "items": { "$ref": "#/$defs/fileAsset" } }
        }
      }
    }
  ],
  "$defs": {
    "nonEmptyString": { "type": "string", "minLength": 1 },
    "nullableString": { "type": ["string", "null"] },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![A-Za-z]:)(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]+$"
    },
    "nullableRelativePath": {
      "anyOf": [
        { "$ref": "#/$defs/relativePath" },
        { "type": "null" }
      ]
    },
    "assetPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![A-Za-z]:)(?!/)[^\\\\]+$"
    },
    "nullableAssetPath": {
      "anyOf": [
        { "$ref": "#/$defs/assetPath" },
        { "type": "null" }
      ]
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "kind"],
      "properties": {
        "path": { "$ref": "#/$defs/relativePath" },
        "kind": { "enum": ["kc", "kel"] }
      }
    },
    "script": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scriptId", "locale", "isEntry", "startLabel", "sourcePath", "klibPath", "klibTextPath"],
      "properties": {
        "scriptId": { "$ref": "#/$defs/nonEmptyString" },
        "locale": { "$ref": "#/$defs/nonEmptyString" },
        "isEntry": { "type": "boolean" },
        "startLabel": { "$ref": "#/$defs/nullableString" },
        "sourcePath": { "$ref": "#/$defs/relativePath" },
        "klibPath": { "$ref": "#/$defs/relativePath" },
        "klibTextPath": { "$ref": "#/$defs/nullableRelativePath" }
      }
    },
    "triggerValue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "text"],
      "properties": {
        "kind": { "enum": ["string", "number", "bool"] },
        "text": { "type": "string" }
      }
    },
    "triggerCondition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "from", "param", "value"],
      "properties": {
        "kind": { "enum": ["from", "is"] },
        "from": { "$ref": "#/$defs/nullableString" },
        "param": { "$ref": "#/$defs/nullableString" },
        "value": {
          "anyOf": [
            { "$ref": "#/$defs/triggerValue" },
            { "type": "null" }
          ]
        }
      }
    },
    "trigger": {
      "type": "object",
      "additionalProperties": false,
      "required": ["conditions", "or"],
      "properties": {
        "conditions": { "type": "array", "items": { "$ref": "#/$defs/triggerCondition" } },
        "or": { "type": "array", "items": { "$ref": "#/$defs/trigger" } }
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["eventId", "type", "chapter", "scriptId", "isEntry", "trigger"],
      "properties": {
        "eventId": { "$ref": "#/$defs/nonEmptyString" },
        "type": { "$ref": "#/$defs/nullableString" },
        "chapter": { "$ref": "#/$defs/relativePath" },
        "scriptId": { "$ref": "#/$defs/nonEmptyString" },
        "isEntry": { "type": "boolean" },
        "trigger": {
          "anyOf": [
            { "$ref": "#/$defs/trigger" },
            { "type": "null" }
          ]
        }
      }
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assetId", "kind", "locale"],
      "properties": {
        "assetId": { "$ref": "#/$defs/nonEmptyString" },
        "kind": { "enum": ["background", "actor", "bgm", "se", "voice", "ui"] },
        "path": { "$ref": "#/$defs/nullableAssetPath" },
        "locale": { "$ref": "#/$defs/nullableString" }
      }
    },
    "fileAsset": {
      "allOf": [
        { "$ref": "#/$defs/asset" },
        {
          "required": ["path"],
          "properties": { "path": { "$ref": "#/$defs/assetPath" } }
        }
      ]
    },
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height", "fullscreen"],
      "properties": {
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "fullscreen": { "type": "boolean" }
      }
    },
    "build": {
      "type": "object",
      "additionalProperties": false,
      "required": ["buildId", "cliVersion", "target"],
      "properties": {
        "buildId": { "$ref": "#/$defs/nonEmptyString" },
        "cliVersion": { "$ref": "#/$defs/nonEmptyString" },
        "target": { "enum": ["windows", "unity", "unreal"] }
      }
    },
    "localization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["locale", "scripts"],
      "properties": {
        "locale": { "$ref": "#/$defs/nonEmptyString" },
        "scripts": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/script" } }
      }
    }
  }
}
